# ============================================================
# GennomX AI — Variáveis de ambiente
# Copiar para .env e preencher os valores reais
# NUNCA commitar o arquivo .env
# ============================================================

# --- Ambiente ---
ENVIRONMENT=development
# development | staging | production

# --- PostgreSQL / Supabase ---
# Migração 2026-07-09: banco principal na VPS; Supabase permanece temporariamente para Auth/JWKS e Storage.
# development | staging | production aceitam DATABASE_PROVIDER=supabase_postgres ou vps_postgres.
DATABASE_PROVIDER=vps_postgres
# Local default:
# DATABASE_URL=postgresql+asyncpg://postgres:change-this-to-a-long-random-postgres-password@localhost:5432/gennomx
# WORKER_DATABASE_URL=postgresql+asyncpg://postgres:change-this-to-a-long-random-postgres-password@localhost:5432/gennomx
# DATABASE_URL_SYNC=postgresql://postgres:change-this-to-a-long-random-postgres-password@localhost:5432/gennomx
#
# PostgreSQL/pgvector na VPS Hostinger (banco principal após cutover):
# - Use somente rede privada Docker/VPS; não publique 5432 na internet.
# - Production exige ssl=require/sslmode=require nas URLs.
DATABASE_URL=postgresql://gennomx_app:change-this-app-password@gennomx-ai-postgres:5432/gennomx?sslmode=require
WORKER_DATABASE_URL=postgresql://gennomx_worker:change-this-worker-password@gennomx-ai-postgres:5432/gennomx?sslmode=require
DATABASE_URL_SYNC=postgresql://gennomx_migrator:change-this-migrator-password@gennomx-ai-postgres:5432/gennomx?sslmode=require
#
# PostgreSQL/pgvector na VPS Hostinger — deploy via docker-compose.vps-app.yml.
# Host do Postgres na rede Docker interna (ver docker-compose.vps-app.yml):
# - Staging (primeira rodada): ENVIRONMENT=staging aceita Redis sem TLS (redis://).
# - Production: exige rediss:// e todas as validacoes de config.py.
# DATABASE_URL=postgresql://gennomx_app:<app-password>@gennomx-ai-postgres-ready-postgres-1:5432/gennomx?sslmode=require
# WORKER_DATABASE_URL=postgresql://gennomx_worker:<worker-password>@gennomx-ai-postgres-ready-postgres-1:5432/gennomx?sslmode=require
# DATABASE_URL_SYNC=postgresql://gennomx_migrator:<migrator-password>@gennomx-ai-postgres-ready-postgres-1:5432/gennomx?sslmode=require
# Redis interno (VPS app stack, sem TLS em staging):
# REDIS_URL=redis://:<redis-password>@redis:6379/0
# CELERY_BROKER_URL=redis://:<redis-password>@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:<redis-password>@redis:6379/1
#
# Supabase hosted DB (legado/rollback temporário):
# DATABASE_PROVIDER=supabase_postgres
# DATABASE_URL=postgresql://gennomx_app:change-this-app-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# WORKER_DATABASE_URL=postgresql://gennomx_worker:change-this-worker-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL_SYNC=postgresql://gennomx_migrator:change-this-migrator-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
POSTGRES_ADMIN_PASSWORD=change-this-to-a-long-random-postgres-admin-password
GENNOMX_BACKUP_PASSWORD=change-this-readonly-or-backup-password
POSTGRES_PASSWORD=change-this-to-a-long-random-postgres-password
PGADMIN_DEFAULT_PASSWORD=change-this-to-a-long-random-pgadmin-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 fallback only. Leave empty after migrating Auth/JWT validation to JWKS.
SUPABASE_JWT_SECRET=

# --- Redis / Celery ---
REDIS_PASSWORD=change-this-to-a-long-random-redis-password
REDIS_URL=redis://:change-this-to-a-long-random-redis-password@localhost:6379/0
CELERY_BROKER_URL=redis://:change-this-to-a-long-random-redis-password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-this-to-a-long-random-redis-password@localhost:6379/1
# Production must use TLS Redis URLs. The production compose expects Redis TLS
# certificates mounted from ./secrets/redis and uses the service host "redis".
# REDIS_URL=rediss://:change-this-to-a-long-random-redis-password@redis:6379/0
# CELERY_BROKER_URL=rediss://:change-this-to-a-long-random-redis-password@redis:6379/0
# CELERY_RESULT_BACKEND=rediss://:change-this-to-a-long-random-redis-password@redis:6379/1

# --- Storage ---
STORAGE_BACKEND=supabase
# supabase | s3
SUPABASE_STORAGE_BUCKET_RAW=gennomx-raw
SUPABASE_STORAGE_BUCKET_PROCESSED=gennomx-processed
SUPABASE_STORAGE_BUCKET_EVIDENCE=gennomx-evidence
# Se usar S3-compatible:
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# --- API ---
# Topologia ativa:
# - Dashboard: https://admin.gennomx.com/ai
# - API: https://admin.gennomx.com/api/ai
# - MCP: https://mcp.gennomx.com
API_DOMAIN=admin.gennomx.com
TLS_ADMIN_EMAIL=admin@gennomx.com
API_SECRET_KEY=change-this-to-a-long-random-secret
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_INTERNAL_KEY=change-this-to-internal-api-key
ROOT_PATH=/api/ai
API_ALLOWED_HOSTS=admin.gennomx.com,mcp.gennomx.com,admin-187-77-239-44.sslip.io,mcp-187-77-239-44.sslip.io

# --- MCP ---
MCP_TOKEN_CHATGPT=change-me-chatgpt-token
MCP_TOKEN_CLAUDE=change-me-claude-token
MCP_TOKEN_PRIVATE_AGENT=change-me-private-agent-token
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_MAX_RESULTS_PER_TOOL=100
MCP_MAX_REQUEST_BYTES=65536

# --- LLM / OPENCODE (motor interno de IA auxiliar) ---
# Provedor configurável; MVP usa OPENCODE com DeepSeek V4 Pro.
# O LLM interno NÃO gera relatórios finais. Tarefas: classificação auxiliar,
# extração estruturada de texto já parseado, sugestão de normalização e triagem.
LLM_PROVIDER=opencode
LLM_MODEL_PREMIUM=deepseek-v4-pro
LLM_MODEL_ECONOMY=deepseek-v4-pro
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_ENABLE_NETWORK_CALLS=false
OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_BASE_URL=
OPENCODE_MODEL_DEEPSEEK_V4_PRO=deepseek-v4-pro
# ── Legado LiteLLM (deprecados; mantidos apenas para referência) ──
# LITELLM_MODEL_PREMIUM=claude-opus-4-8
# LITELLM_MODEL_ECONOMY=claude-haiku-4-5-20251001
# LITELLM_MAX_TOKENS=4096
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=

# --- Conectores: ClinicalTrials.gov ---
CLINICALTRIALS_API_BASE_URL=https://clinicaltrials.gov/api/v2
CLINICALTRIALS_RATE_LIMIT_REQUESTS_PER_SECOND=5
CLINICALTRIALS_MAX_RETRIES=3
CLINICALTRIALS_INCREMENTAL_LOOKBACK_DAYS=2
CLINICALTRIALS_MAX_RECORDS_PER_RUN=5000

# --- Conectores: PubMed/NCBI ---
NCBI_API_KEY=your-ncbi-api-key
NCBI_EMAIL=your-email@example.com
PUBMED_RATE_LIMIT_REQUESTS_PER_SECOND=10

# --- Conectores: openFDA ---
OPENFDA_API_BASE_URL=https://api.fda.gov
OPENFDA_API_KEY=your-openfda-api-key
OPENFDA_RATE_LIMIT_REQUESTS_PER_SECOND=5
OPENFDA_MAX_RETRIES=3
OPENFDA_MAX_RECORDS_PER_RUN=2000
OPENFDA_INGEST_HOUR_UTC=3

# --- Conectores: DailyMed ---
DAILYMED_API_BASE_URL=https://dailymed.nlm.nih.gov/dailymed
DAILYMED_RATE_LIMIT_REQUESTS_PER_SECOND=5
DAILYMED_MAX_RETRIES=3
DAILYMED_MAX_RECORDS_PER_RUN=2000
DAILYMED_INGEST_HOUR_UTC=3

# --- Conectores: EMA ---
EMA_API_BASE_URL=https://www.ema.europa.eu
EMA_MEDICINES_EXPORT_URL=https://www.ema.europa.eu/en/documents/report/medicines-output-medicines-report_en.xlsx
EMA_MAX_RETRIES=3
EMA_MAX_RECORDS_PER_RUN=2000
EMA_INGEST_HOUR_UTC=4

# --- Conectores: Open Targets ---
OPEN_TARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql
OPEN_TARGETS_RATE_LIMIT_REQUESTS_PER_SECOND=5
OPEN_TARGETS_MAX_RETRIES=3
OPEN_TARGETS_MAX_RECORDS_PER_RUN=500
OPEN_TARGETS_INGEST_HOUR_UTC=4
OPEN_TARGETS_SEED_DISEASE_TERMS=non-small cell lung cancer,breast cancer,multiple myeloma,rheumatoid arthritis,type 2 diabetes,Alzheimer disease,melanoma,acute myeloid leukemia

# --- Logging ---
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json
# json | text (development)

# --- CORS ---
# Production/staging:
# CORS_ORIGINS=https://admin.gennomx.com,https://admin-187-77-239-44.sslip.io
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# --- Frontend ---
NEXT_PUBLIC_BASE_PATH=/ai
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=https://admin.gennomx.com/api/ai
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000/ai
# NEXT_PUBLIC_APP_URL=https://admin.gennomx.com/ai
